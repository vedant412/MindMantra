# SERVER ONLY. Never copy these credentials into the mobile .env.
APP_ENV=production
DATABASE_URL=postgresql+psycopg://app_runtime:REPLACE@ep-REPLACE-pooler.REGION.aws.neon.tech/mindmitra?sslmode=require
# Only migration/maintenance jobs receive this owner credential.
DATABASE_MIGRATION_URL=postgresql+psycopg://schema_owner:REPLACE@ep-REPLACE.REGION.aws.neon.tech/mindmitra?sslmode=require
NEON_AUTH_BASE_URL=https://ep-REPLACE.neonauth.REGION.aws.neon.tech/neondb/auth
# Optional overrides. Defaults: issuer/audience = origin of BASE_URL; JWKS = BASE_URL/.well-known/jwks.json
NEON_AUTH_JWKS_URL=
NEON_AUTH_ISSUER=
NEON_AUTH_AUDIENCE=
# Secret Fernet key, required only for native browser handoffs. Generate as described in QUICKSTART.md.
NEON_AUTH_HANDOFF_KEY=
GEMINI_API_KEY=REPLACE
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_TEXT_MODEL=gemini-2.5-flash
LIVE_ENABLED=false
LIVE_MAX_SESSION_SECONDS=900
RAG_ENABLED=false
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_API_KEY=REPLACE
EMBEDDING_DIMENSIONS=768
EMBEDDING_PROFILE=google-gemini-embedding-001-768-v1
TRANSCRIPT_RETENTION_DAYS=90
LOCATION_RETENTION_DAYS=30
STRUCTURED_DATA_RETENTION_DAYS=365
DEFAULT_USER_TIMEZONE=Asia/Kolkata
CORS_ALLOWED_ORIGINS=https://app.example.com
